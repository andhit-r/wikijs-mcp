# ============================================================================
# Konfigurasi wikijs-mcp
# Salin file ini menjadi `.env` lalu isi nilai yang sesuai.
# JANGAN pernah commit file `.env` yang berisi credential asli.
# ============================================================================

# ---------------------------------------------------------------------------
# Koneksi ke Wiki.js GraphQL API (WAJIB)
# ---------------------------------------------------------------------------
# URL dasar instance Wiki.js (tanpa trailing slash).
WIKIJS_URL=https://wiki.yourdomain.com

# API key Wiki.js. Buat di:
#   Admin Interface -> System -> API Access
# Token ini dikirim sebagai header: Authorization: Bearer <WIKIJS_API_KEY>
WIKIJS_API_KEY=your-wikijs-api-key

# Timeout (detik) untuk setiap request ke Wiki.js GraphQL. Opsional.
WIKIJS_TIMEOUT=30

# Verifikasi sertifikat TLS saat memanggil Wiki.js (true/false). Opsional.
WIKIJS_VERIFY_SSL=true

# ---------------------------------------------------------------------------
# Login via Authentik (OAuth Proxy + Dynamic Client Registration) — Claude Web
# ---------------------------------------------------------------------------
# Dengan mode ini, pengguna TIDAK perlu mengisi client id/secret di Claude.
# Claude mendaftar otomatis (DCR) dan pengguna cukup LOGIN di Authentik.
#
# Syarat di Authentik:
#   - Buat OAuth2/OpenID Provider + Application untuk MCP ini.
#   - Redirect URI diarahkan ke: <MCP_BASE_URL>/auth/callback
#
# Mode OAuth Proxy AKTIF bila semua field AUTHENTIK_* + MCP_BASE_URL terisi.
AUTHENTIK_BASE_URL=https://auth.yourdomain.com
AUTHENTIK_APP_SLUG=wikijs-mcp
AUTHENTIK_CLIENT_ID=your-oauth-client-id
AUTHENTIK_CLIENT_SECRET=your-oauth-client-secret

# Daftar username Authentik yang diizinkan login (dipisah koma).
# Kosongkan untuk mengizinkan SEMUA user yang berhasil login di Authentik.
# Contoh: andhit-r,user2
AUTHENTIK_ALLOWED_USERNAMES=

# ---------------------------------------------------------------------------
# API Key statis (untuk VS Code / CLI / tools non-OAuth)
# ---------------------------------------------------------------------------
# Client wajib menyertakan header: Authorization: Bearer <MCP_API_KEY>
# Kosongkan untuk menonaktifkan mode ini.
MCP_API_KEY=

# ---------------------------------------------------------------------------
# Konfigurasi runtime MCP server
# ---------------------------------------------------------------------------
# Transport: "http" (default, untuk remote/Claude.ai) atau "stdio" (lokal).
MCP_TRANSPORT=http

# URL publik MCP server ini. WAJIB diisi agar login via Authentik (OAuth Proxy)
# berfungsi — dipakai untuk OAuth metadata & redirect callback.
# Contoh: https://mcp.yourdomain.com
MCP_BASE_URL=

# Host & port saat transport=http.
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Level log: DEBUG, INFO, WARNING, ERROR.
MCP_LOG_LEVEL=INFO
